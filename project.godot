; Projet Godot — Bamako Moto
;
; Ce fichier est lu par Godot au demarrage. Il s'edite normalement depuis
; Projet > Parametres du projet, mais il reste du texte : on peut le lire,
; le comparer et le versionner comme n'importe quel autre fichier.

config_version=5

[application]

config/name="Bamako Moto"
config/description="Descends l'avenue, esquive les sotramas."
run/main_scene="res://scenes/garage.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Donnees="*res://scripts/donnees.gd"

[display]

; Portrait, comme un telephone tenu a la main.
window/size/viewport_width=720
window/size/viewport_height=1280
; L'image s'etire pour remplir l'ecran quel qu'il soit, en gardant la
; largeur : sur un telephone plus allonge, on voit simplement plus loin
; devant soi, ce qui ne desavantage personne.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input]

gauche={
