[rendering]

; « GL Compatibility » et non « Forward+ » : c'est le moteur de rendu qui
; tourne sur les cartes graphiques integrees et sur les telephones Android
; d'entree de gamme. C'est le choix qui decide si ton jeu s'ouvre ou non
; sur le telephone de la moitie de tes joueurs.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
